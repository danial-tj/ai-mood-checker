<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aimoodchecker.controller.HistoryController" spacing="24" styleClass="page">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="YOUR JOURNAL" styleClass="eyebrow"/><Label text="Moments, in your words." styleClass="page-title"/><Label text="A place to return to. A way to see how far you've come." styleClass="subtitle" wrapText="true"/></VBox>
        <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="16"><Label fx:id="entryCount" text="Your reflections" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Explore trends  →" onAction="#onViewGraph" styleClass="text-button"/></HBox>
    <StackPane VBox.vgrow="ALWAYS" minHeight="200">
        <TableView fx:id="historyTable" styleClass="history-table">
            <columns>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="110" minWidth="90"/>
                <TableColumn fx:id="moodColumn" text="Mood" prefWidth="90" minWidth="72"/>
                <TableColumn fx:id="descriptionColumn" text="Reflection" prefWidth="300" minWidth="140"/>
                <TableColumn fx:id="sentimentColumn" text="Text tone" prefWidth="100" minWidth="90"/>
                <TableColumn fx:id="actionsColumn" text="" prefWidth="100" minWidth="100" sortable="false"/>
            </columns>
        </TableView>
        <Label fx:id="noDataLabel" text="Your story starts here.&#10;Add a daily check-in to begin your journal." styleClass="empty-state" visible="false" wrapText="true"/>
    </StackPane>
    <Label text="Double-click a reflection, or select it and press Enter, to read the full entry." styleClass="page-note" wrapText="true"/>
</VBox>
